<Page x:Class="LigaApp.MVVM.View.ResultadosView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LigaApp.MVVM.View"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:VM="clr-namespace:LigaApp.MVVM.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ResultadosView">

    <Page.DataContext>
        <VM:TablaLigaViewModel/>
    </Page.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding CargarTablaCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Background="#FF1E1E2E">

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            
            <ItemsControl ItemsSource="{Binding listaResultados}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
    
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    
                    <Border MinWidth="280"
                            Background="#19FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                            CornerRadius="15"
                            Margin="10"
                            Padding="15">
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding FECHA}"
                                       Foreground="#FF8B8B9E"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Margin="0,0,0,15"/>

                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Image Source="{Binding EscudoCompletoLocal}" Width="50" Height="50"/>
                                <TextBlock Text="{Binding NOMBRE}"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Background="#33FFFFFF" CornerRadius="10"
                                    HorizontalAlignment="Center"
                                    Margin="0,5,0,5"
                                    Padding="15, 8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding G_LOCAL}"
                                               Foreground="White" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text=" - "
                                               Foreground="#FF8B8B9E" FontSize="18" Margin="10,0"/>
                                    <TextBlock Text="{Binding G_VISITANTE}"
                                               Foreground="White" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Image Source="{Binding EscudoCompletoVisitante}" Width="50" Height="50"/>
                                <TextBlock Text="{Binding NOMBRE_VISITANTE}"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                            
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Page>
