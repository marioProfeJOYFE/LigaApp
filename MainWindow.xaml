<Window x:Class="LigaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LigaApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FF1E1E2E">
        

        <Frame x:Name="MainFrame"
               
               NavigationUIVisibility="Hidden" Margin="5"/>

        <Border 
                Background="#19FFFFFF"      BorderBrush="#33FFFFFF"    BorderThickness="1"
                CornerRadius="30"           HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,15"
                Padding="10,5">
            
            <StackPanel Orientation="Horizontal">
                
                <RadioButton x:Name="HomeButton"
                             Content="&#xE80F;" 
                             GroupName="NavGroup"
                             Style="{StaticResource NavButtonStyle}"
                             IsChecked="True"
                             Checked="HomeButton_Checked"/>
                
                <RadioButton x:Name="ProfileButton"
                             Content="&#xe773;" 
                             GroupName="NavGroup"
                             Style="{StaticResource NavButtonStyle}"
                             Checked="ProfileButton_Checked"/>
                
            </StackPanel>
        </Border>
        
    </Grid>
</Window>
